# 浏览器与宿主机运行 Python 时使用的地址。
NEXTAUTH_URL=http://localhost:3000
S3_PUBLIC_URL=http://localhost:9090
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000

# init_env.py 会生成以下公私钥；Compose 在首次启动时创建相同的项目密钥。
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
LOGIN_EMAIL=demo@example.com
LOGIN_PASSWORD=CHANGE_ME

# 真实模型凭证需要你本地填写；模型必须支持工具调用。
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# 本示例读取的可选 JSON 请求参数；DeepSeek 示例见使用说明。
OPENAI_EXTRA_BODY={}

DEMO_USER_ID=user-demo-001
DEMO_SESSION_ID=conversation-demo-001
DEMO_QUESTION=请调用 query_order 查询订单 ORD-1001，告诉我状态和快递单号。

# 服务端及数据库密钥由 init_env.py 自动随机生成。
POSTGRES_PASSWORD=CHANGE_ME
REDIS_AUTH=CHANGE_ME
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME
SALT=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# 默认连接 Compose 内的单机 ClickHouse；外接时同时修改两个入口。
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_MIGRATION_SSL=false
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DB=langfuse

LANGFUSE_TRACING_ENVIRONMENT=development
