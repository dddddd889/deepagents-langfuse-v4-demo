# 模拟演示不需要凭证；真实体验从终端环境或本目录 .env 读取。
# 已在终端设置 TAMS_TOKEN 时，不必复制此文件，也不要用占位符覆盖已有值。
MODEL_PROVIDER=tams
TAMS_TOKEN=请在本地填写
TAMS_BASE_URL=https://dev-cn.tensorart.net/v2/openapi/v1
TAMS_MODEL=volcano/deepseek-v4-1-flash-260910

# 如需改用其他 OpenAI 兼容接口，将 MODEL_PROVIDER 改为 openai 并填写以下配置。
# OPENAI_API_KEY=请在本地填写
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
